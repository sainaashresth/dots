// Minimal Waybar for Hyprland -- chips with rounded corners, transparent bar.
// Modules: workspaces | active apps | volume | RAM | battery | date+time
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["hyprland/workspaces", "group/music"],
    "modules-center": ["custom/apps"],
    "modules-right": ["pulseaudio", "group/sys", "memory", "battery", "clock"],

    // Workspaces: no numbers. Five are always shown (inactive = dot,
    // active = dash) so the bar doesn't shift when desktops come and go.
    "hyprland/workspaces": {
        "format": " {icon} ",
        "format-icons": {
            "default": " "
        },
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-number": true,
        "tooltip": false,
        "persistent-workspaces": {
            "*": 5
        }
    },

    // ---- hover drawer: music ----
    "group/music": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "transition-left-to-right": true,
            "children-class": "drawer-child"
        },
        "modules": [
            "custom/music",
            "custom/music-prev",
            "custom/music-play",
            "custom/music-next",
            "custom/music-title"
        ]
    },
    "custom/music": {
        "format": "♫",
        "tooltip": false
    },
    "custom/music-prev": {
        "format": "◀◀",
        "tooltip": false,
        "on-click": "playerctl previous",
        "on-click-right": "playerctl position 10-"
    },
    "custom/music-play": {
        "exec": "$HOME/.config/waybar/scripts/music-hover.sh state",
        "interval": 1,
        "tooltip": false,
        "on-click": "playerctl play-pause"
    },
    "custom/music-next": {
        "format": "▶▶",
        "tooltip": false,
        "on-click": "playerctl next",
        "on-click-right": "playerctl position 10+"
    },
    "custom/music-title": {
        "exec": "$HOME/.config/waybar/scripts/music-hover.sh title",
        "interval": 2,
        "max-length": 32,
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl play-pause"
    },

    // ---- hover drawer: system stats ----
    "group/sys": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "transition-left-to-right": true,
            "children-class": "drawer-child"
        },
        "modules": [
            "custom/sys",
            "cpu#drawer",
            "memory#drawer",
            "temperature#drawer",
            "disk#drawer"
        ]
    },
    "custom/sys": {
        "format": "",
        "tooltip": false
    },
    "cpu#drawer": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": false
    },
    "memory#drawer": {
        "format": "RAM {used:0.1f}G/{total:0.1f}G",
        "interval": 2,
        "tooltip": false
    },
    "temperature#drawer": {
        "format": "{temperatureC}°C",
        "format-critical": "{temperatureC}°C !",
        "critical-threshold": 80,
        "thermal-zone": 1,
        "interval": 2,
        "tooltip": false
    },
    "disk#drawer": {
        "format": "Disk {percentage_used}%",
        "path": "/",
        "interval": 30,
        "tooltip": false
    },

    // Centre: windows on the focused workspace only. The focused window is
    // shown as its app glyph in the accent colour, the rest as dim dots.
    // The script prints continuously and is driven by Hyprland's event
    // socket, so no poll interval is needed.
    "custom/apps": {
        "exec": "$HOME/.config/waybar/scripts/active-apps.py",
        "escape": false,
        "tooltip": false,
        "restart-interval": 1
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip-format": "{desc}"
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G  ({percentage}%)"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power:0.1f}W"
    },

    "clock": {
        "timezone": "Asia/Kathmandu",
        "format": "󰃭 {:%a %I:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "format": {
                "months": "<span color='#33ccff'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "today": "<span color='#00ff99'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    }
}
